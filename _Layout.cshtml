<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PJAverageRate</title>
    <script type="importmap"></script>
   
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-datepicker@1.10.0/dist/css/bootstrap-datepicker.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PJAverageRate.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="PJAverageRate"></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                      @*   <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                         *@
                    </ul>
                </div>
            </div>
            <div class="ms-auto">
                <div class="btn-group" role="group">
                    <button type="button"
                            id="Add"
                            name="Modeall"
                            value="ADD"
                            onclick="OnAddClick()"
                            class="btn mode-btn" >
                        ADD
                    </button>

                    <button type="button" id="Modify" name="Modeall" value="Modify" onclick="OnModifyClick()" class="btn mode-btn">MODIFY</button>
                    <button type="button" id="View" name="Modeall" value="View" onclick="OnViewClick()" class="btn mode-btn">VIEW</button>
                    <button type="button" id="DeActivate" name="Modeall" value="DeActivate" onclick="OnDActivateClick()" class="btn mode-btn">DEACTIVATE</button>
                    <button type="button" id="ReActivate" name="Modeall" value="ReActivate" onclick="OnReActivateClick()" class="btn mode-btn">REACTIVATE</button>
                </div>
            </div>
        </nav>  
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="ms-auto">
            <div class="btn-group" role="group">
                    @* <form asp-controller="PjAvgRateConfirm" asp-action="Confirm" method="post">
                        <button type="submit" >
                            Confirm
                        </button>
                    </form> *@
                    <button type="submit" id="ConfirmClick" onclick="return OnConfirmClick()" form="avgRateForm" formaction="@Url.Action("Confirm", "PjAvgRateConfirm")" formmethod="post" class="btn btn-warning" disabled="@(Model.IsViewconMode)">
                        Confirm
                    </button>

                    <form asp-controller="PJAverageRate" asp-action="Clear" method="post">
                        <button type="submit" onclick="return OnClearClick()" class="btn btn-primary">
                            Clear
                        </button>
                    </form>

                    <form asp-controller="PJAverageRate" asp-action="Clear" method="post">
                        <button type="submit" id="CancelClick" onclick="return OnCancelClick()" class="btn btn-danger">
                            Cancel
                        </button>
                    </form>
            </div>
        </div>
        </nav>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-datepicker@1.10.0/dist/js/bootstrap-datepicker.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/PJAverageRate.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
    